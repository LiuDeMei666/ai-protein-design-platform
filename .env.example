# ============================================================
# AI 辅助蛋白设计平台 - 环境变量样例
# 复制为 .env 后按需修改。所有项都有代码内默认值，可不配置直接启动。
# ============================================================

# ---------- 服务 ----------
DBZ_HOST=0.0.0.0
DBZ_PORT=8848
DBZ_DEBUG=false

# ---------- HuggingFace 权重源 ----------
# 实测 huggingface.co 直连失败（SSL），必须使用镜像
HF_ENDPOINT=https://hf-mirror.com

# ---------- 蛋白语言模型 ----------
DBZ_ESM_MODEL=facebook/esm2_t33_650M_UR50D
DBZ_ESM_FALLBACK_MODEL=facebook/esm2_t12_35M_UR50D
DBZ_DEVICE=auto
DBZ_USE_FP16=true

# ---------- 结构预测 Provider ----------
# auto | esmatlas | local_esmfold | stub
DBZ_STRUCTURE_PROVIDER=auto
DBZ_ESMATLAS_URL=https://api.esmatlas.com/foldSequence/v1/pdb/
DBZ_ESMATLAS_TIMEOUT=120
DBZ_ESMATLAS_CONCURRENCY=2

# ---------- 异步作业 ----------
DBZ_JOB_WORKERS=2
DBZ_JOB_TIMEOUT_SECONDS=3600
DBZ_SERIALIZE_HEAVY_JOBS=true

# ---------- 鉴权（留空则不启用） ----------
# DBZ_API_KEY=change-me

# ---------- 路径覆盖（默认全部在项目内） ----------
# DBZ_DATA_DIR=/data/danbaizhi/data
# DBZ_MODELS_DIR=/data/danbaizhi/models
# DBZ_DB_PATH=/data/danbaizhi/data/db/platform.db
